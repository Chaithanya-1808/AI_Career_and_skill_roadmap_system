# =====================================================================
# AI Career & Smart Roadmap System - Environment Configuration Example
# Copy this file to .env and customize the values for your environment.
# =====================================================================

# Project Name & API Prefix
PROJECT_NAME="AI Career & Smart Roadmap System"
API_V1_STR="/api"

# JWT Authentication & Security
# WARNING: Change this SECRET_KEY in production environments!
SECRET_KEY="ai-career-smart-roadmap-dev-secret-key-32chars-min-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Local SQLite database stored in backend root
# PostgreSQL / Supabase format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL="sqlite:///./career_path.db"

# Supabase Integration (Optional for local development; required for cloud Supabase)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI Provider Configuration (Google Gemini)
# Leave blank to use the deterministic, rule-based fallback roadmap generation engine
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

# Certificate Verification Base URL (used in generated QR codes & verification links)
CERTIFICATE_VERIFICATION_BASE_URL="http://localhost:5173/verify-certificate"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
